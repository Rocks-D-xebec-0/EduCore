# Database Configuration
# Copy this file to .env and fill in your actual credentials
# .env is ignored by git and will never be committed

# PostgreSQL Database (supports local or cloud like Neon)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educore_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL_MODE=disable

# For Neon.tech cloud database, use:
# DB_HOST=ep-wandering-surf-aph5mg8r-pooler.c-7.us-east-1.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_password
# DB_SSL_MODE=require
